; Engine configuration file.
; Fog Nomad — Godot 0.2 — art identity, physical world, interaction
;
; Renderer:   MOBILE  (never Forward+ — see docs/BENCHMARK_REPORT.md)
; Language:   GDScript only (no C#, no GDExtension, no editor plugin)
; Orientation:PORTRAIT, reference window 720 x 1280
;
; This file is intentionally kept minimal and hand-readable so it can be
; opened and edited from the Godot Editor for Android on a phone.

config_version=5

[application]

config/name="NOMADSLAND — Godot 0.2.1"
config/description="0.2.1 — movement, collision and game feel.
Mobile renderer, GDScript only, portrait. Every movement number lives in
scripts/player/player_movement_config.gd (section 36); physics layers in
docs/PHYSICS_CONVENTIONS.md. Main scene is the benchmark world; the review
scene is scenes/testing/ArtPhysicsShowcase.tscn."
config/version="0.2.1"
run/main_scene="res://scenes/BenchmarkWorld.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.055, 0.063, 0.086, 1)
boot_splash/show_image=false

; Layer names, so the inspector checkboxes are labelled instead of numbered.
; These MUST stay in step with scripts/physics_layers.gd — that file is the
; source of truth and this block is its mirror for the editor UI.
[layer_names]

3d_physics/layer_1="WORLD_STATIC"
3d_physics/layer_2="PLAYER"
3d_physics/layer_3="NPC"
3d_physics/layer_4="ANIMAL"
3d_physics/layer_5="INTERACTABLE"
3d_physics/layer_6="PICKUP"
3d_physics/layer_7="WATER"
3d_physics/layer_8="HAZARD_FOG"

[autoload]

Quality="*res://scripts/quality.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/resizable=true
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

; Section 7. The touch JUMP button calls PlayerController.press_jump()
; directly, the same way the stick writes move_input — the InputMap entries
; are what make the same jump reachable from a keyboard or a pad while
; developing, and are the named action any future rebinding screen edits.
[input]

jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":69,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":2,"pressure":0.0,"pressed":false,"script":null)
]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194325,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":1,"pressure":0.0,"pressed":false,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/default_gravity=18.0
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1536
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.mobile=1
anti_aliasing/quality/screen_space_aa=0
scaling_3d/mode=0
textures/default_filters/anisotropic_filtering_level=1
environment/defaults/default_clear_color=Color(0.086, 0.102, 0.137, 1)
