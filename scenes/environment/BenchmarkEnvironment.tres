[gd_resource type="Environment" load_steps=3 format=3]

; Lighting and atmosphere for the benchmark (section 33).
;
; Constrained to what the MOBILE renderer actually supports: sky, ambient
; from sky, tonemapping, depth fog and glow. SSAO, SSIL, SDFGI and VOLUMETRIC
; FOG are Forward+ only and are deliberately absent — the Brume is built out
; of geometry instead (see scripts/fog/fog_wall.gd).
;
; The depth fog is tuned to hand off to the Brume: same violet cast, so the
; far distance desaturates into the curtain instead of ending at it.

[sub_resource type="ProceduralSkyMaterial" id="Sky_material"]
sky_top_color = Color(0.208, 0.271, 0.384, 1)
sky_horizon_color = Color(0.529, 0.541, 0.576, 1)
sky_curve = 0.18
sky_energy_multiplier = 1.0
