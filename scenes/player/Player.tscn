[gd_scene load_steps=5 format=3]

; The player. Capsule spans y = 0 .. 1.6, so the body origin IS the feet:
; the model sits at the origin with no offset to get wrong, which is what
; keeps the character standing on the ground instead of in it (section 17).

[ext_resource type="Script" path="res://scripts/player/player_controller.gd" id="1_player"]
[ext_resource type="PackedScene" path="res://assets/characters/player_hooded_scout.glb" id="2_model"]
[ext_resource type="Script" path="res://scripts/interaction/interactor.gd" id="3_interactor"]

[sub_resource type="CapsuleShape3D" id="Capsule_body"]
radius = 0.33
height = 1.6

[sub_resource type="SphereShape3D" id="Sphere_reach"]
radius = 2.7

[node name="Player" type="CharacterBody3D"]
collision_layer = 2
collision_mask = 1
